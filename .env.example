# Copy to .env (or set in your host's dashboard). Never commit the real values.
NODE_ENV=production
PORT=3000
# Where the database, selfies and documents are stored. Must be a persistent disk.
DATA_DIR=/var/lib/attendance
# Long random string used to encrypt selfies and documents. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe: if you lose it, stored files cannot be decrypted.
APP_SECRET=
